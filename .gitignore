# Flutter build output — the app's sources are tracked, its artefacts are not
apps/flutter/**/.dart_tool/
apps/flutter/**/build/
apps/flutter/**/.idea/
apps/flutter/**/*.iml
apps/flutter/**/.flutter-plugins-dependencies

# A shared package should not pin its consumers.
apps/flutter/avatar_view/pubspec.lock

# Discovered MCP tool lists are one machine's observations, not configuration.
runtime_data/config/mcp-discovered-tools.json
apps/flutter/**/ios/
apps/poppyinyourpocket/ios/

# Credentials the runner writes at runtime. Never in the repo: these are live
# OAuth tokens for the user's own Google account.
runtime_data/data/google-tokens.json
runtime_data/data/google-agent-tokens/
runtime_data/data/users.json

# The whole of runtime_data now lives outside both repositories, in one
# place set by HATS_DATA. Avatars were 136MB tracked here and duplicated
# in the runner repo; outputs/ is work agents produced, not source.
runtime_data/

# A test install run from inside the repository.
deploy/data/
