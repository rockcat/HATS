{
  "name": "hats",
  "version": "0.2.0",
  "description": "AI agents with distinct personas based on De Bono's Six Thinking Hats",
  "license": "SEE LICENSE IN LICENSE.txt",
  "author": "Ely House 25 Ltd",
  "type": "module",
  "main": "server/dist/server/src/index.js",
  "workspaces": [
    "packages/auth",
    "packages/clients",
    "packages/contracts",
    "packages/core",
    "packages/service-kit",
    "packages/speech-core"
  ],
  "scripts": {
    "build": "tsc -p server/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx --env-file=.env server/src/team-runner.ts",
    "start": "node --env-file=.env --import tsx/esm server/src/team-runner.ts",
    "start:standalone": "node --env-file=.env --import tsx/esm server/src/team-runner.ts --standalone",
    "update-pricing": "tsx --env-file=.env server/src/tools/pricing-updater.ts",
    "services": "node --env-file=.env scripts/dev-services.mjs",
    "agent-library": "node --env-file=.env --import tsx/esm apps/agent-library/src/main.ts",
    "project-server": "node --env-file=.env --import tsx/esm apps/project-server/src/main.ts",
    "project-designer": "node --env-file=.env --import tsx/esm apps/project-designer/src/main.ts",
    "embodiment-test": "node --env-file=.env --import tsx/esm apps/embodiment-test/src/main.ts",
    "speech-service": "node --env-file=.env --import tsx/esm apps/speech-service/src/main.ts",
    "companion": "node --env-file=.env --import tsx/esm apps/companion/src/main.ts",
    "project-view": "node --env-file=.env --import tsx/esm apps/project-view/src/main.ts",
    "auth-service": "node --env-file=.env --import tsx/esm apps/auth-service/src/main.ts",
    "runner-manager": "node --env-file=.env --import tsx/esm apps/runner-manager/src/main.ts",
    "electron:run": "electron --env-file=.env apps/electron/main.js"
  },
  "build": {
    "appId": "com.hatagents.app",
    "productName": "Hat Agents",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@kmamal/sdl/**/*"
    ],
    "extraMetadata": {
      "main": "apps/electron/main.js"
    },
    "files": [
      "apps/web/**/*",
      "apps/electron/main.js",
      "package.json"
    ],
    "directories": {
      "output": "dist-desktop"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@pixiv/three-vrm": "^3.5.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fflate": "^0.8.2",
    "js-yaml": "^4.3.2",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "nodemailer": "^10.1.1",
    "openai": "^4.85.0",
    "qrcode": "^1.5.4",
    "swagger-ui-dist": "^5.36.0",
    "three": "0.162.0",
    "tsx": "^4.19.0",
    "uuid": "^11.1.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/three": "0.162.0",
    "@types/ws": "^8.18.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.59.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
