{
  "name": "hat-agents",
  "version": "0.1.0",
  "description": "AI agents with distinct personas based on De Bono's Six Thinking Hats",
  "license": "SEE LICENSE IN LICENSE.txt",
  "author": "Ely House 25 Ltd",
  "type": "module",
  "scripts": {
    "runner": "docker compose up -d runner",
    "runner:logs": "docker compose logs -f runner",
    "runner:stop": "docker compose down",
    "runner:build": "docker build -t hats-runner:latest ../hats-runner",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent-library": "node --env-file=.env --import tsx/esm apps/agent-library/src/main.ts",
    "project-server": "node --env-file=.env --import tsx/esm apps/project-server/src/main.ts",
    "project-designer": "node --env-file=.env --import tsx/esm apps/project-designer/src/main.ts",
    "embodiment-test": "node --env-file=.env --import tsx/esm apps/embodiment-test/src/main.ts",
    "services": "node --env-file=.env scripts/dev-services.mjs",
    "services:all": "node --env-file=.env scripts/dev-services.mjs --with-runner",
    "electron:run": "electron --env-file=.env apps/electron/main.js",
    "speech-service": "node --env-file=.env --import tsx/esm apps/speech-service/src/main.ts",
    "companion": "node --env-file=.env --import tsx/esm apps/companion/src/main.ts",
    "project-view": "node --env-file=.env --import tsx/esm apps/project-view/src/main.ts"
  },
  "build": {
    "appId": "com.hatagents.app",
    "productName": "Hat Agents",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@kmamal/sdl/**/*"
    ],
    "extraMetadata": {
      "main": "apps/electron/main.js"
    },
    "files": [
      "apps/web/**/*",
      "apps/electron/main.js",
      "package.json"
    ],
    "directories": {
      "output": "dist-desktop"
    }
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.4",
    "three": "0.162.0",
    "@hats/core": "file:../hats-runner/packages/core",
    "@hats/contracts": "file:../hats-runner/packages/contracts",
    "@hats/clients": "file:../hats-runner/packages/clients",
    "@hats/service-kit": "file:../hats-runner/packages/service-kit",
    "@hats/speech-core": "file:../hats-runner/packages/speech-core",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "0.162.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
