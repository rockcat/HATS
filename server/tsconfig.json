{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    // The server imports the shared contracts and clients from packages/, so the
    // compilation root is the repo, not server/src. Emitted entry point is
    // therefore server/dist/server/src/team-runner.js.
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "../packages/contracts/src/**/*",
    "../packages/service-kit/src/**/*",
    "../packages/clients/src/**/*"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
