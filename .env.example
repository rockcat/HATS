HATS_ADMIN_USERNAME=admin
HATS_ADMIN_PASSWORD=changeme
# What runners show the services (runner manager, Project Server) to prove
# they belong to this installation. Set the same value here and in every
# runner's .env; without it any caller is taken for a runner.
#HATS_RUNNER_TOKEN=
# Public base URL used in QR pairing codes (e.g. http://192.168.1.42:3001)
# Leave unset to auto-detect from the HTTP Host header (works for browser on same machine)
#HATS_PUBLIC_URL=http://192.168.1.42:3001
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
BRAVE_API_KEY=your_brave_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
TEAM_PROJECT=default

# ── HATS services ────────────────────────────────────────────────────────────
# The Team Runner reads its agent definitions from the Agent Template Library and its
# project definition from the Project Server. Both are optional: if a service is
# not running, the runner falls back to local files. Run the runner with
# --standalone (or HATS_STANDALONE=1) to skip the lookups entirely.
AGENT_LIBRARY_URL=http://localhost:3010
PROJECT_SERVER_URL=http://localhost:3020
TEAM_RUNNER_URL=http://localhost:3001
# Speech Service — owns the Piper TTS servers. The runner and the Agent Template Library
# both ask it for audio; without it agents simply do not speak.
SPEECH_SERVICE_URL=http://localhost:3050

# Ports each service listens on
AGENT_LIBRARY_PORT=3010
PROJECT_SERVER_PORT=3020
PROJECT_DESIGNER_PORT=3030
EMBODIMENT_TEST_PORT=3040
SPEECH_SERVICE_PORT=3050
TEAM_RUNNER_PORT=3001

# Where the services keep their data
AGENT_LIBRARY_DIR=./runtime_data/agent-library/templates
PROJECT_DEFINITIONS_DIR=./runtime_data/project-server/definitions
RHUBARB_BIN=runtime_data/rhubarb/rhubarb
PIPER_BIN=runtime_data/piper/piper.exe
PIPER_VOICES_DIR=runtime_data/piper_voices
PIPER_SERVER_PORT_START=5100
# PYTHON_BIN=python
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=

# Credential the Embodiment API test harness presents to the Team Runner,
# which authenticates all of /api/*. Only that harness needs it — the Agent
# Library, Project Server and Project Designer have no runner dependency.
#
# To mint one, with the runner running:
#   node --env-file=.env scripts/issue-api-key.mjs
# Revoke keys from the dashboard: Settings -> Users.
HATS_API_KEY=

# If you want to enable Google OAuth, set the client ID and secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=