<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow HTTP cleartext to any host — required for local dev server over LAN.
         The server URL changes with WiFi assignment, so we can't whitelist a specific IP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
