{
  "name": "@hats/avatar-camera",
  "version": "0.1.0",
  "description": "Puts an agent on camera: headless avatar rendering, lip-sync, and video out to OBS, SRT or a window.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kmamal/sdl": "^0.11.13",
    "@napi-rs/canvas": "^0.1.97",
    "@pixiv/three-vrm": "^3.5.4",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "gl": "^8.1.6",
    "openai": "^4.85.0",
    "three": "0.162.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.0.0",
    "@types/three": "0.162.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "SEE LICENSE IN LICENSE.txt"
}
