{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "packages/*/src/**/*",
    "packages/ui-kit/index.ts",
    "apps/*/src/**/*",
    "team-runner.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-desktop",
    "apps/flutter",
    "**/public/**"
  ]
}
