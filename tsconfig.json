{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": [
    "server/src/**/*",
    "packages/*/src/**/*",
    "packages/ui-kit/index.ts",
    "apps/agent-library/src/**/*",
    "apps/project-server/src/**/*",
    "apps/project-designer/src/**/*",
    "apps/embodiment-test/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-desktop",
    "server/dist",
    "apps/flutter",
    "apps/electron",
    "apps/web",
    "**/public/**"
  ]
}
