# HATS installation settings. Every container reads this file.
#
# Paths and service addresses are not set here: docker-compose.yml points
# each container at the data folder and at the other services itself.

# ── Sign-in to the dashboard ─────────────────────────────────────────────────
HATS_ADMIN_USERNAME=admin
HATS_ADMIN_PASSWORD=changeme
# What runners show the services to prove they belong to this installation.
# The installer fills it in; without it any caller is taken for a runner.
HATS_RUNNER_TOKEN=
# Address phones use to reach this machine in QR pairing codes. Leave unset
# to use whatever address the browser connected with.
#HATS_PUBLIC_URL=http://192.168.1.42:3001

# ── Model providers ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
# Local models on this machine. Set the model name to use one.
OLLAMA_MODEL=
LM_STUDIO_MODEL=
# Only if they run somewhere other than this machine's default ports.
#DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
#DOCKER_LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1

# ── Tools ────────────────────────────────────────────────────────────────────
BRAVE_API_KEY=

# ── Google sign-in (calendar, Gmail, Drive) ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Installation ─────────────────────────────────────────────────────────────
# Image version: latest, or a release such as 0.1.3 to stay on it.
HATS_VERSION=latest
# Where the data folder is. Default: ./data beside this file.
#HATS_DATA=D:/hats-data

# Key the Embodiment API test harness uses to reach the runner. Mint one,
# once the runner is up, from the dashboard: Settings -> Users.
HATS_API_KEY=
